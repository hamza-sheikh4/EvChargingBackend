# App
NODE_ENV=development
PORT=8000
APP_URL=http://localhost:3000

# Login tokens
JWT_SECRET=
JWT_EXPIRES_IN=30d

# OTP
OTP_SECRET=
OTP_DEV_MODE=true

# Database (Supabase, session pooler)
DATABASE_URL=

# Storage (Cloudflare R2)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=evchargingsolutions-dev

# CNIC encryption (AES-256-GCM, 64 hex characters). Changing it makes saved CNICs unreadable.
CNIC_ENCRYPTION_KEY=
