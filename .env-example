# App
NODE_ENV=development
PORT=8001
APP_URL=http://localhost:3000
# The landing site: checked every 5 minutes for the Health page, and allowed to report page errors.
LANDING_URL=
# Shown on the Health page; set by your deploy, for example from git rev-parse --short HEAD.
GIT_COMMIT=

# Login tokens
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Admin panel logins (separate from the app).
# Super admins are managed with `npm run super-admin`, never with env vars.
ADMIN_JWT_SECRET=

# Email codes (hash key) and sending. Gmail App Password for now, Resend later.
# With no SMTP_USER, codes print to the server console (development only).
OTP_SECRET=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Database (Supabase, session pooler)
DATABASE_URL=

# Storage (Cloudflare R2)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=evchargingsolutions-dev

# CNIC encryption (AES-256-GCM, 64 hex characters). Changing it makes saved CNICs unreadable.
CNIC_ENCRYPTION_KEY=

# Google sign-in: the Web client ID from Google Cloud
GOOGLE_WEB_CLIENT_ID=
